SUPABASE_URL=your_supabase_project_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# Frontend Supabase client: use the anon/public key, never the service key.
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Leave empty for local development (Vite proxies /api to Express).
# Set to your deployed Express API origin for the production frontend build.
VITE_API_URL=